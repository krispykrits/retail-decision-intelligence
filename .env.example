# Optional local overrides; defaults work without this file.
RDI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local development; initialize with make migrate.
RDI_DATABASE_URL=sqlite+pysqlite:///./retail.db
# Azure uses these instead of DATABASE_URL and the app's managed identity.
# RDI_SQL_SERVER=your-server.database.windows.net
# RDI_SQL_DATABASE=retail
# Vite development proxy; never exposes a database URL to the frontend.
RDI_API_PROXY_TARGET=http://127.0.0.1:8000
# Accounts: generate a local key with python -c "import secrets; print(secrets.token_urlsafe(48))".
# RDI_AUTH_SECRET=<generated-value>
RDI_PUBLIC_URL=http://localhost:5173
# STARTTLS mail delivery; never commit credentials.
# RDI_MAIL__HOST=smtp.example.com
# RDI_MAIL__PORT=587
# RDI_MAIL__USERNAME=<smtp-user>
# RDI_MAIL__PASSWORD=<smtp-password>
# RDI_MAIL__SENDER=<verified-sender-email>

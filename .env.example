# Optional local overrides; defaults work without this file.
RDI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# In-memory SQLite is for local SQL tests only. Azure SQL connectivity is issue #3.
RDI_DATABASE_URL=sqlite+pysqlite:///:memory:
# Vite development proxy; never exposes a database URL to the frontend.
RDI_API_PROXY_TARGET=http://127.0.0.1:8000

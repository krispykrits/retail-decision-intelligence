{
  "components": {
    "schemas": {
      "AccountConfiguration": {
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "email_delivery": {
            "title": "Email Delivery",
            "type": "boolean"
          }
        },
        "required": [
          "configured",
          "email_delivery"
        ],
        "title": "AccountConfiguration",
        "type": "object"
      },
      "AccountRead": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "display_name",
          "email",
          "roles"
        ],
        "title": "AccountRead",
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "CsrfToken": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "CsrfToken",
        "type": "object"
      },
      "EmailRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "const": "retail-decision-intelligence",
            "default": "retail-decision-intelligence",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "LinkToken": {
        "properties": {
          "token": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "LinkToken",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RegisterAccount": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "email",
          "password"
        ],
        "title": "RegisterAccount",
        "type": "object"
      },
      "ResetPassword": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "ResetPassword",
        "type": "object"
      },
      "Role": {
        "enum": [
          "Analyst",
          "Administrator"
        ],
        "title": "Role",
        "type": "string"
      },
      "RoleChange": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ],
        "title": "RoleChange",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "CSRFToken": {
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Retail Decision Intelligence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts/{account_id}/role": {
      "put": {
        "operationId": "change_account_role",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Change Role",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "operationId": "get_account_configuration",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountConfiguration"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Account Configuration",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "get_csrf_token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfToken"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Csrf",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "operationId": "request_password_reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Forgot Password",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Login",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Register",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/request-verify": {
      "post": {
        "operationId": "request_email_verification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Request Verification",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Reset Password",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkToken"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Verify",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Process liveness only; database readiness is a separate concern.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "Return the account identified by the server-issued HttpOnly session cookie.",
        "operationId": "get_current_account",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Require connectivity and the expected migration; never expose SQL errors.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}

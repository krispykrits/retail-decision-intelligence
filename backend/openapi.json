{
  "components": {
    "schemas": {
      "AccountConfiguration": {
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "email_delivery": {
            "title": "Email Delivery",
            "type": "boolean"
          }
        },
        "required": [
          "configured",
          "email_delivery"
        ],
        "title": "AccountConfiguration",
        "type": "object"
      },
      "AccountRead": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "display_name",
          "email",
          "roles"
        ],
        "title": "AccountRead",
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "CsrfToken": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "CsrfToken",
        "type": "object"
      },
      "EmailRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "const": "retail-decision-intelligence",
            "default": "retail-decision-intelligence",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "LinkToken": {
        "properties": {
          "token": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ],
        "title": "LinkToken",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RegisterAccount": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "display_name",
          "email",
          "password"
        ],
        "title": "RegisterAccount",
        "type": "object"
      },
      "ResetPassword": {
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "token": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "ResetPassword",
        "type": "object"
      },
      "Role": {
        "enum": [
          "Analyst",
          "Administrator"
        ],
        "title": "Role",
        "type": "string"
      },
      "RoleChange": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ],
        "title": "RoleChange",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "CSRFToken": {
        "description": "Call GET /api/v1/auth/csrf, then enter its token in Authorize. Keep the matching cookie. Required on every write, including sign-in.",
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "DevelopmentSession": {
        "description": "Development HTTPS session cookie, issued by sign-in and sent automatically by the browser.",
        "in": "cookie",
        "name": "__Host-rdi_session",
        "type": "apiKey"
      },
      "LocalSession": {
        "description": "Local HTTP session cookie, issued by sign-in and sent automatically by the browser.",
        "in": "cookie",
        "name": "rdi_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Retail Decision Intelligence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts/{account_id}/role": {
      "put": {
        "description": "Requires an Administrator session and CSRF token. Assigns Analyst or Administrator in SQL.\n\nAn administrator cannot change their own role. The target's next API request uses the new\npermission without waiting for token expiry. Returns the target's public account profile.",
        "operationId": "change_account_role",
        "parameters": [
          {
            "description": "UUID of another existing application account.",
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "description": "UUID of another existing application account.",
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session is missing, invalid, expired or revoked, or the account is inactive/unverified."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Administrator access is required; self-changes and invalid CSRF/origin are forbidden."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The target account does not exist."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": [],
            "LocalSession": []
          },
          {
            "CSRFToken": [],
            "DevelopmentSession": []
          }
        ],
        "summary": "Change another account's application role",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "description": "Public endpoint. Returns configuration flags without secrets or SMTP credentials.\n\nResponses are not cached. A configured sender has not necessarily been delivery-tested.",
        "operationId": "get_account_configuration",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountConfiguration"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read public account configuration",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "description": "Public endpoint. Sets an HttpOnly, SameSite=Strict cookie and returns its signed token.\n\nSend the token in `X-CSRF-Token` on writes, including registration and sign-in.\nIn Swagger, enter it under **Authorize \u2192 CSRFToken**. Keep cookies enabled and\nuse the same origin. Refresh the token after one hour or after replacing its cookie.\nDevelopment cookies require HTTPS. This endpoint does not sign in the caller.",
        "operationId": "get_csrf_token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "summary": "Get a CSRF token and cookie",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "description": "Public write with CSRF protection. Emails a 30-minute recovery link to an active account.\n\nMissing or inactive accounts also return 202. Requesting a link does not change the password\nor revoke sessions. Actual SMTP failures return 503 rather than reporting successful delivery.",
        "operationId": "request_password_reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Request accepted; does not reveal whether the account exists."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF cookie/header is missing, mismatched or expired, or the request Origin is untrusted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests. Retry after the rate-limit window.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the rate-limit window is available.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Request a password recovery link",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Public write requiring CSRF protection. Accepts JSON credentials for a verified account.\n\nIssues an eight-hour HttpOnly, SameSite=Strict session cookie (Secure in development).\nReplaces this browser's previous session; other sessions remain active. No session token\nis returned in JSON. Requests are rate-limited by account and connection address.",
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session cookie issued; no response body."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Credentials are incorrect, or the account is inactive/unverified."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF cookie/header is missing, mismatched or expired, or the request Origin is untrusted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests. Retry after the rate-limit window.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the rate-limit window is available.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Sign in with email and password",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Requires a valid session and CSRF token. Revokes this browser's session in SQL.\n\nEither application role can sign out. Other sessions remain active. Reusing the revoked\ncookie fails authentication; an already-expired or revoked session returns 401.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Session revoked and cookie cleared; no response body."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session is missing, invalid, expired or revoked, or the account is inactive/unverified."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF cookie/header is missing, mismatched or expired, or the request Origin is untrusted."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": [],
            "LocalSession": []
          },
          {
            "CSRFToken": [],
            "DevelopmentSession": []
          }
        ],
        "summary": "Revoke the current session",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Public write requiring CSRF protection. Creates an unverified Analyst and emails a link.\n\nExisting accounts also return 202 without changing credentials or permissions.\nUse request-verify to resend a link. Account/verification flags cannot be supplied.\nEmail delivery must be configured; sign-in is blocked until verification succeeds.",
        "operationId": "register_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Registration accepted; the same response is returned for existing accounts."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF cookie/header is missing, mismatched or expired, or the request Origin is untrusted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests. Retry after the rate-limit window.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the rate-limit window is available.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Register an Analyst account",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/request-verify": {
      "post": {
        "description": "Public write requiring CSRF protection. Emails a new link to an active, unverified account.\n\nMissing, inactive and already-verified accounts also return 202. Links expire after\n30 minutes and cannot verify an account again after successful verification.",
        "operationId": "request_email_verification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Request accepted; does not reveal account existence or verification status."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF cookie/header is missing, mismatched or expired, or the request Origin is untrusted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests. Retry after the rate-limit window.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the rate-limit window is available.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Resend an email verification link",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "description": "Public write requiring CSRF protection. Sets a new password using a valid recovery token.\n\nRevokes every session in the same SQL transaction as the password change. The token cannot\nbe reused afterward. Does not create a new session or verify an unverified email address.",
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Password changed and all account sessions revoked; sign in again."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Recovery token is invalid, expired, already used or belongs to another flow."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF cookie/header is missing, mismatched or expired, or the request Origin is untrusted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests. Retry after the rate-limit window.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the rate-limit window is available.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Reset a password using an email token",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "description": "Public write requiring CSRF protection. Consumes the verification email's token.\n\nThis verifies email ownership without creating a session or granting Administrator access.\nRecovery tokens cannot be used here. Submit explicitly rather than following a GET link.",
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkToken"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Email verified; sign-in is now available."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Verification token is invalid, expired, already used or belongs to another flow."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CSRF cookie/header is missing, mismatched or expired, or the request Origin is untrusted."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests. Retry after the rate-limit window.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait when the rate-limit window is available.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Verify account email ownership",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Public endpoint. Returns 200 while the API process can serve requests.\n\nDoes not query SQL or check email delivery. Use /ready for database readiness.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check API process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "Requires a session cookie. Returns account ID, display name, email and current roles.\n\nSQL is authoritative: role changes and account disabling apply on the next request.\nResponses are not cached and contain no password hashes, session tokens or credential metadata.",
        "operationId": "get_current_account",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session is missing, invalid, expired or revoked, or the account is inactive/unverified."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or required email delivery is unavailable."
          }
        },
        "security": [
          {
            "LocalSession": []
          },
          {
            "DevelopmentSession": []
          }
        ],
        "summary": "Read the signed-in account",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Public endpoint. Checks SQL connectivity and migration compatibility with this build.\n\nReturns 503 with a safe unavailable status and Retry-After: 15 otherwise. Responses are\nnot cached and expose no database errors. Does not test email delivery.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "SQL cannot be reached or migrations do not match the application.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying (15).",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Check database and migration readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}

{
  "components": {
    "schemas": {
      "AccountRead": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "display_name",
          "email",
          "roles"
        ],
        "title": "AccountRead",
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "CsrfToken": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "CsrfToken",
        "type": "object"
      },
      "Dataset": {
        "enum": [
          "households",
          "products",
          "transactions"
        ],
        "title": "Dataset",
        "type": "string"
      },
      "DatasetSummary": {
        "properties": {
          "dataset": {
            "$ref": "#/components/schemas/Dataset"
          },
          "last_success": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "records": {
            "title": "Records",
            "type": "integer"
          },
          "source_window": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceWindow"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "dataset",
          "records",
          "last_success",
          "source_window",
          "version"
        ],
        "title": "DatasetSummary",
        "type": "object"
      },
      "EmailRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "const": "retail-decision-intelligence",
            "default": "retail-decision-intelligence",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ImportErrorRow": {
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "row_number": {
            "title": "Row Number",
            "type": "integer"
          }
        },
        "required": [
          "row_number",
          "reason"
        ],
        "title": "ImportErrorRow",
        "type": "object"
      },
      "ImportResult": {
        "properties": {
          "conflicts": {
            "title": "Conflicts",
            "type": "integer"
          },
          "dataset": {
            "$ref": "#/components/schemas/Dataset"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "duplicates_skipped": {
            "title": "Duplicates Skipped",
            "type": "integer"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ImportErrorRow"
            },
            "title": "Errors",
            "type": "array"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "finished_at": {
            "format": "date-time",
            "title": "Finished At",
            "type": "string"
          },
          "import_id": {
            "format": "uuid",
            "title": "Import Id",
            "type": "string"
          },
          "inserted": {
            "title": "Inserted",
            "type": "integer"
          },
          "processed": {
            "title": "Processed",
            "type": "integer"
          },
          "rejected": {
            "title": "Rejected",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/ImportStatus"
          }
        },
        "required": [
          "import_id",
          "dataset",
          "filename",
          "status",
          "finished_at",
          "processed",
          "inserted",
          "duplicates_skipped",
          "conflicts",
          "rejected",
          "errors"
        ],
        "title": "ImportResult",
        "type": "object"
      },
      "ImportStatus": {
        "enum": [
          "completed",
          "completed_with_errors",
          "failed"
        ],
        "title": "ImportStatus",
        "type": "string"
      },
      "LinkToken": {
        "properties": {
          "token": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ],
        "title": "LinkToken",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RegisterAccount": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "display_name",
          "email",
          "password"
        ],
        "title": "RegisterAccount",
        "type": "object"
      },
      "ResetPassword": {
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "token": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "ResetPassword",
        "type": "object"
      },
      "Role": {
        "enum": [
          "Analyst",
          "Administrator"
        ],
        "title": "Role",
        "type": "string"
      },
      "SourceWindow": {
        "properties": {
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "SourceWindow",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "CSRFToken": {
        "description": "CSRF token returned by GET /api/v1/auth/csrf; required on writes.",
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "DevelopmentSession": {
        "in": "cookie",
        "name": "__Host-rdi_session",
        "type": "apiKey"
      },
      "LocalSession": {
        "in": "cookie",
        "name": "rdi_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Retail Decision Intelligence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "description": "Public. Sets the CSRF cookie; send the returned token as X-CSRF-Token on writes.\nIn Swagger, enter the token under Authorize. Expires after one hour.",
        "operationId": "get_csrf_token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "summary": "Get a CSRF token and cookie",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "description": "Public with CSRF. Sends a 30-minute recovery link to an active account.\nMissing and inactive accounts also return 202; email delivery failures return 503.",
        "operationId": "request_password_reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid CSRF token or request origin."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests; retry later."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Request a password recovery link",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Public with CSRF. Signs in a verified account and issues an eight-hour HttpOnly session.\nThe cookie is Secure in development; an existing browser session is replaced.",
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid credentials or unverified/inactive account."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid CSRF token or request origin."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests; retry later."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Sign in with email and password",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Requires a session and CSRF. Revokes this session in SQL and clears its cookie.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid, expired or revoked session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid CSRF token or request origin."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": [],
            "LocalSession": []
          },
          {
            "CSRFToken": [],
            "DevelopmentSession": []
          }
        ],
        "summary": "Revoke the current session",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Public with CSRF. Creates an unverified Analyst and emails a verification link.\nExisting accounts also return 202. Verification is required before sign-in.",
        "operationId": "register_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid CSRF token or request origin."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests; retry later."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Register an Analyst account",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/request-verify": {
      "post": {
        "description": "Public with CSRF. Sends a 30-minute verification link to an unverified account.\nMissing, inactive and verified accounts also return 202.",
        "operationId": "request_email_verification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid CSRF token or request origin."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests; retry later."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Resend an email verification link",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "description": "Public with CSRF. Changes the password and revokes all sessions atomically.\nThe recovery token cannot be reused; sign in again afterward.",
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid, expired or used recovery token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid CSRF token or request origin."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests; retry later."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Reset a password using an email token",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "description": "Public with CSRF. Verifies email ownership using the emailed token.\nExpired or used links fail; successful verification does not sign in the account.",
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkToken"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid, expired or used verification token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid CSRF token or request origin."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many account requests; retry later."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account configuration, SQL or email delivery unavailable."
          }
        },
        "security": [
          {
            "CSRFToken": []
          }
        ],
        "summary": "Verify account email ownership",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/datasets": {
      "get": {
        "description": "Returns record counts, last successful import, source date range and version.",
        "operationId": "list_datasets_api_v1_datasets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DatasetSummary"
                  },
                  "title": "Response List Datasets Api V1 Datasets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
